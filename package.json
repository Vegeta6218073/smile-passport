{
  "name": "smile-passport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "seed:dev": "node --env-file=.env.local scripts/create-dev-users.mjs",
    "worker": "node --env-file=.env.local worker/run.mjs",
    "worker:loop": "node --env-file=.env.local worker/run.mjs --loop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "web-push": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
