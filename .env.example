# Copy to .env.local and fill from the output of `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by scripts/create-dev-users.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Set to true to force every signed-in user to enrol a 2FA factor
REQUIRE_2FA=false

# Idle sign-out in minutes (adjust with the clinic)
NEXT_PUBLIC_IDLE_MINUTES=30

# Smile Passport public intake (/smile). The form writes with the service role, so the
# clinic that receives scans is fixed here. Use the clinic's id from the clinics table.
SMILE_PASSPORT_CLINIC_ID=

# WhatsApp (docs/automation.md). dry_run sends nothing and just logs. Switch to meta_cloud only after
# testing with a sandbox number.
WHATSAPP_PROVIDER=dry_run
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Webhook: the verify token is any random string you also enter in Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Clinic that owns the WhatsApp number (falls back to SMILE_PASSPORT_CLINIC_ID)
WHATSAPP_CLINIC_ID=
